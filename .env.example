# SQLite file, relative to prisma/ — keep as-is unless you know why
DATABASE_URL="file:./data/nexus.db"

# Long random string; sessions are signed with it. Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# How often the worker re-pulls the last FAST_LOOKBACK_DAYS (minutes)
SYNC_INTERVAL_MINUTES=30
FAST_LOOKBACK_DAYS=7
# Nightly 03:30 Berlin pass re-pulls this many days (late conversions)
DEEP_LOOKBACK_DAYS=30

META_API_VERSION=v23.0
