generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  role         String      @default("BUYER") // ADMIN | BUYER
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  adAccounts   AdAccount[]
}

model BusinessManager {
  id              String      @id @default(cuid())
  name            String
  systemUserToken String
  status          String      @default("ACTIVE") // ACTIVE | RETIRED
  createdAt       DateTime    @default(now())
  adAccounts      AdAccount[]
}

model AdAccount {
  id            String          @id @default(cuid())
  metaAccountId String          @unique // numeric id, without "act_" prefix
  name          String
  bmId          String
  bm            BusinessManager @relation(fields: [bmId], references: [id], onDelete: Cascade)
  ownerId       String?
  owner         User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  status        String          @default("ACTIVE") // ACTIVE | RETIRED
  currency      String          @default("USD")
  timezone      String?
  createdAt     DateTime        @default(now())
  metaStats     MetaStat[]
}

model EverflowInstance {
  id         String         @id @default(cuid())
  name       String
  apiKey     String
  timezoneId Int            @default(56) // Europe/Berlin (see GET /v1/meta/timezones)
  status     String         @default("ACTIVE") // ACTIVE | RETIRED
  createdAt  DateTime       @default(now())
  efStats    EverflowStat[]
  offers     Offer[]
}

// Offers buyers can generate tracking links for.
model Offer {
  id             String           @id @default(cuid())
  instanceId     String
  instance       EverflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  networkOfferId String? // Everflow network_offer_id; null for manually added offers
  name           String
  trackingUrl    String // base tracking URL; subids + source_id are appended on generation
  status         String           @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt      DateTime         @default(now())

  @@unique([instanceId, networkOfferId])
}

// One row per ad per day (Meta spend side)
model MetaStat {
  id           String    @id @default(cuid())
  date         String // YYYY-MM-DD in account timezone (Berlin)
  adAccountId  String
  adAccount    AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId   String
  campaignName String
  adsetId      String
  adsetName    String
  adId         String
  adName       String
  spend        Float     @default(0)
  impressions  Int       @default(0)
  clicks       Int       @default(0) // inline link clicks
  updatedAt    DateTime  @updatedAt

  @@unique([date, adId])
  @@index([date])
  @@index([campaignId])
  @@index([adsetId])
  @@index([adAccountId, date])
}

// One row per (day, instance, sub1/sub3/sub4, offer) (Everflow revenue side)
model EverflowStat {
  id          String           @id @default(cuid())
  date        String // YYYY-MM-DD in instance reporting timezone (Berlin)
  instanceId  String
  instance    EverflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  campaignId  String           @default("") // sub1 = {{campaign.id}}
  adsetId     String           @default("") // sub3 = {{adset.id}}
  adId        String           @default("") // sub4 = {{ad.id}}
  sourceId    String           @default("") // source_id = meta ad account id
  offerId     String           @default("")
  offerName   String           @default("")
  clicks      Int              @default(0) // total_click
  conversions Int              @default(0) // cv
  revenue     Float            @default(0) // affiliate payout
  updatedAt   DateTime         @updatedAt

  @@unique([date, instanceId, campaignId, adsetId, adId, sourceId, offerId])
  @@index([date])
  @@index([adId])
  @@index([campaignId])
}

// Creative info per Meta ad (thumbnail etc.). Thumbnail bytes are cached on
// disk (see lib/thumbs.ts) because Meta's CDN URLs are signed and expire.
model AdCreative {
  adId             String    @id
  creativeId       String    @default("")
  thumbnailUrl     String    @default("") // signed Meta CDN URL (expires)
  imageUrl         String    @default("")
  videoId          String    @default("")
  storyId          String    @default("") // effective_object_story_id = "<pageId>_<postId>"
  instagramMediaId String    @default("")
  postUrl          String    @default("") // unused; kept so `db push` on boot stays non-destructive
  fetchedAt        DateTime  @default(now())
  cachedAt         DateTime? // when thumbnail bytes were written to the disk cache
}

model SyncRun {
  id           String    @id @default(cuid())
  kind         String // META | EVERFLOW
  targetName   String // ad account / instance name at time of run
  targetId     String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String    @default("RUNNING") // RUNNING | OK | ERROR
  message      String    @default("")
  rowsUpserted Int       @default(0)
  rangeFrom    String    @default("")
  rangeTo      String    @default("")

  @@index([startedAt])
}
